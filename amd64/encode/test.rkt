#lang racket
;;; amd64/encode/test.rkt
;;;
;;; 第一版编码 golden test。只测已经实现的 form。

(require rackunit
         "../insn.rkt")

(define (enc name . operands)
  (encode-instruction name operands))

(check-equal? (enc 'mov 'rax 'rbx) (bytes #x48 #x89 #xd8))
(check-equal? (enc 'mov 'rax 'rcx) (bytes #x48 #x89 #xc8))
(check-equal? (enc 'mov 'r8 'rax) (bytes #x49 #x89 #xc0))
(check-equal? (enc 'mov 'rax 'r8) (bytes #x4c #x89 #xc0))

(check-equal? (enc 'mov 'rax '(b64 (base rbp) (disp -8)))
              (bytes #x48 #x8b #x45 #xf8))
(check-equal? (enc 'mov '(b64 (base rbp) (disp -8)) 'rax)
              (bytes #x48 #x89 #x45 #xf8))
(check-equal? (enc 'mov 'rax '(b64 (base rip) (disp 0)))
              (bytes #x48 #x8b #x05 #x00 #x00 #x00 #x00))
(check-equal? (enc 'mov 'rax '(b64 (disp #x1234)))
              (bytes #x48 #x8b #x04 #x25 #x34 #x12 #x00 #x00))

(check-equal? (enc 'lea 'rax '(b64 (base rbx) (index rcx) (scale 4) (disp 8)))
              (bytes #x48 #x8d #x44 #x8b #x08))
(check-equal? (enc 'mov 'rax '(b64 (base rsp) (index rcx) (disp 0)))
              (bytes #x48 #x8b #x04 #x0c))

(check-equal? (enc 'add 'rax 8) (bytes #x48 #x83 #xc0 #x08))
(check-equal? (enc 'add 'rax 1000) (bytes #x48 #x81 #xc0 #xe8 #x03 #x00 #x00))
(check-equal? (enc 'sub 'rsp 16) (bytes #x48 #x83 #xec #x10))
(check-equal? (enc 'cmp 'rax 0) (bytes #x48 #x83 #xf8 #x00))
(check-equal? (enc 'add '(b64 (base rax) (disp 0)) 1)
              (bytes #x48 #x83 #x00 #x01))

(check-equal? (enc 'mov 'eax 1) (bytes #xb8 #x01 #x00 #x00 #x00))
(check-equal? (enc 'mov 'rax 1) (bytes #x48 #xc7 #xc0 #x01 #x00 #x00 #x00))
(check-equal? (enc 'mov 'rax #xffffffff) (bytes #xb8 #xff #xff #xff #xff))
(check-equal? (enc 'mov 'rax #x100000000) (bytes #x48 #xb8 #x00 #x00 #x00 #x00 #x01 #x00 #x00 #x00))
(check-equal? (enc 'mov 'al 1) (bytes #xb0 #x01))
(check-equal? (enc 'mov 'spl 1) (bytes #x40 #xb4 #x01))
(check-equal? (enc 'mov 'ah 1) (bytes #xb4 #x01))
(check-equal? (enc 'add 'ah 1) (bytes #x80 #xc4 #x01))

(check-equal? (enc 'push 'rax) (bytes #x50))
(check-equal? (enc 'pop 'r8) (bytes #x41 #x58))

(check-equal? (enc 'jmp-short 8) (bytes #xeb #x08))
(check-equal? (enc 'jmp-near 8) (bytes #xe9 #x08 #x00 #x00 #x00))
(check-equal? (enc 'jcc-short 'e 8) (bytes #x74 #x08))
(check-equal? (enc 'jcc-near 'e 8) (bytes #x0f #x84 #x08 #x00 #x00 #x00))
(check-equal? (enc 'call-near 8) (bytes #xe8 #x08 #x00 #x00 #x00))
(check-equal? (enc 'ret) (bytes #xc3))

(displayln "amd64 encode tests: ok")

;; size must agree with encoding
(check-equal? (instruction-size 'mov '(rax rbx)) 3)
(check-equal? (instruction-size 'add '(rax 8)) 4)
(check-equal? (instruction-size 'add '(rax 1000)) 7)
(check-equal? (instruction-size 'jmp-short '((done))) 2)
(check-equal? (instruction-size 'jmp-near '((done))) 5)
(check-equal? (instruction-size 'jcc-near '(e (done))) 6)
(check-equal? (instruction-size 'call-near '((done))) 5)
(check-equal? (instruction-size 'mov '(rax (b64 (base rbp) (disp -8)))) 4)

;; unary / test / shift / multiply / divide / extend / setcc
(check-equal? (enc 'test 'rax 'rbx) (bytes #x48 #x85 #xd8))
(check-equal? (enc 'test 'rax 1) (bytes #x48 #xf7 #xc0 #x01 #x00 #x00 #x00))
(check-equal? (enc 'inc 'rax) (bytes #x48 #xff #xc0))
(check-equal? (enc 'dec 'rax) (bytes #x48 #xff #xc8))
(check-equal? (enc 'neg 'rax) (bytes #x48 #xf7 #xd8))
(check-equal? (enc 'not 'rax) (bytes #x48 #xf7 #xd0))
(check-equal? (enc 'shl 'rax 1) (bytes #x48 #xc1 #xe0 #x01))
(check-equal? (enc 'shr 'rax 1) (bytes #x48 #xc1 #xe8 #x01))
(check-equal? (enc 'sar 'rax 1) (bytes #x48 #xc1 #xf8 #x01))
(check-equal? (enc 'imul 'rax 'rbx) (bytes #x48 #x0f #xaf #xc3))
(check-equal? (enc 'idiv 'rcx) (bytes #x48 #xf7 #xf9))
(check-equal? (enc 'div 'rcx) (bytes #x48 #xf7 #xf1))
(check-equal? (enc 'movzx 'rax 'al) (bytes #x48 #x0f #xb6 #xc0))
(check-equal? (enc 'movzx 'eax 'al) (bytes #x0f #xb6 #xc0))
(check-equal? (enc 'movsx 'rax 'al) (bytes #x48 #x0f #xbe #xc0))
(check-equal? (enc 'movsx 'rax 'eax) (bytes #x48 #x63 #xc0))
(check-equal? (enc 'setcc 'e 'al) (bytes #x0f #x94 #xc0))
(check-equal? (enc 'cmovcc 'e 'rax 'rbx) (bytes #x48 #x0f #x44 #xc3))
(check-equal? (enc 'cqo) (bytes #x48 #x99))
(check-equal? (enc 'cdq) (bytes #x99))

;; imul forms, shift by cl, push/pop memory and immediate
(check-equal? (enc 'imul 'rax) (bytes #x48 #xf7 #xe8))
(check-equal? (enc 'imul 'rax 'rbx 5) (bytes #x48 #x6b #xc3 #x05))
(check-equal? (enc 'imul 'rax 'rbx 1000) (bytes #x48 #x69 #xc3 #xe8 #x03 #x00 #x00))
(check-equal? (enc 'shl 'rax 'cl) (bytes #x48 #xd3 #xe0))
(check-equal? (enc 'push 0) (bytes #x6a #x00))
(check-equal? (enc 'push 1000) (bytes #x68 #xe8 #x03 #x00 #x00))
(check-equal? (enc 'push '(b64 (base rbp) (disp -8))) (bytes #xff #x75 #xf8))
(check-equal? (enc 'pop '(b64 (base rbp) (disp -8))) (bytes #x8f #x45 #xf8))

;; exchange, bit scan, atomic-ish integer instructions
(check-equal? (enc 'xchg 'al 'ah) (bytes #x86 #xe0))
(check-equal? (enc 'xchg 'rax 'rbx) (bytes #x48 #x87 #xd8))
(check-equal? (enc 'bswap 'eax) (bytes #x0f #xc8))
(check-equal? (enc 'bswap 'rax) (bytes #x48 #x0f #xc8))
(check-equal? (enc 'bsf 'rax 'rbx) (bytes #x48 #x0f #xbc #xc3))
(check-equal? (enc 'bsr 'rax 'rbx) (bytes #x48 #x0f #xbd #xc3))
(check-equal? (enc 'popcnt 'rax 'rbx) (bytes #xf3 #x48 #x0f #xb8 #xc3))
(check-equal? (enc 'shrd 'eax 'edx 5) (bytes #x0f #xac #xd0 #x05))
(check-equal? (enc 'shrd 'rax 'rdx 'cl) (bytes #x48 #x0f #xad #xd0))

;; system / fixed forms
(check-equal? (enc 'cdqe) (bytes #x48 #x98))
(check-equal? (enc 'cpuid) (bytes #x0f #xa2))
(check-equal? (enc 'rdtsc) (bytes #x0f #x31))
(check-equal? (enc 'rdtscp) (bytes #x0f #x01 #xf9))
(check-equal? (enc 'syscall) (bytes #x0f #x05))
(check-equal? (enc 'clc) (bytes #xf8))
(check-equal? (enc 'stc) (bytes #xf9))
(check-equal? (enc 'cli) (bytes #xfa))
(check-equal? (enc 'sti) (bytes #xfb))
(check-equal? (enc 'hlt) (bytes #xf4))
(check-equal? (enc 'pause) (bytes #xf3 #x90))
(check-equal? (enc 'pushfq) (bytes #x9c))
(check-equal? (enc 'popfq) (bytes #x9d))
(check-equal? (enc 'mfence) (bytes #x0f #xae #xf0))
(check-equal? (enc 'lfence) (bytes #x0f #xae #xe8))
(check-equal? (enc 'sfence) (bytes #x0f #xae #xf8))
(check-equal? (enc 'clflush '(b8 (base rax))) (bytes #x0f #xae #x38))

;; port I/O
(check-equal? (enc 'in 'eax 'dx) (bytes #xed))
(check-equal? (enc 'in 'al 'dx) (bytes #xec))
(check-equal? (enc 'in 'eax 128) (bytes #xe5 #x80))
(check-equal? (enc 'in 'al 128) (bytes #xe4 #x80))
(check-equal? (enc 'out 'dx 'eax) (bytes #xef))
(check-equal? (enc 'out 'dx 'al) (bytes #xee))
(check-equal? (enc 'out 128 'eax) (bytes #xe7 #x80))
(check-equal? (enc 'out 128 'al) (bytes #xe6 #x80))

;; atomic exchanges and random
(check-equal? (enc 'cmpxchg '(b64 (base rax)) 'rbx) (bytes #x48 #x0f #xb1 #x18))
(check-equal? (enc 'xadd '(b64 (base rax)) 'rbx) (bytes #x48 #x0f #xc1 #x18))
(check-equal? (enc 'rdrand 'rax) (bytes #x48 #x0f #xc7 #xf0))
(check-equal? (enc 'rdseed 'rax) (bytes #x48 #x0f #xc7 #xf8))

;; prefix wrapper and implicit-operand string instructions
(check-equal? (enc 'movs '(b64 (base rdi)) '(b64 (base rsi)))
              (bytes #x48 #xa5))
(check-equal? (enc 'stos '(b64 (base rdi)) 'rax)
              (bytes #x48 #xab))
(check-equal? (enc 'ins '(b32 (base rdi)) 'dx)
              (bytes #x6d))
(check-equal? (enc 'outs 'dx '(b32 (base rsi)))
              (bytes #x6f))
(check-equal? (enc 'prefix 'lock '(xadd (b64 (base rax)) rbx))
              (bytes #xf0 #x48 #x0f #xc1 #x18))
(check-equal? (enc 'prefix 'rep '(movs (b64 (base rdi)) (b64 (base rsi))))
              (bytes #xf3 #x48 #xa5))
(check-equal? (instruction-size 'prefix
                                (list 'lock '(xadd (b64 (base rax)) rbx)))
              5)

;; SSE / XMM
(check-equal? (enc 'movss 'xmm1 'xmm2) (bytes #xf3 #x0f #x10 #xca))
(check-equal? (enc 'movss 'xmm1 '(b32 (base rax))) (bytes #xf3 #x0f #x10 #x08))
(check-equal? (enc 'movss '(b32 (base rax)) 'xmm1) (bytes #xf3 #x0f #x11 #x08))
(check-equal? (enc 'movq 'xmm1 'xmm2) (bytes #xf3 #x0f #x7e #xca))
(check-equal? (enc 'movq 'xmm1 'rax) (bytes #x66 #x48 #x0f #x6e #xc8))
(check-equal? (enc 'movq 'rax 'xmm1) (bytes #x66 #x48 #x0f #x7e #xc8))
(check-equal? (enc 'movq 'xmm1 '(b64 (base rax))) (bytes #xf3 #x0f #x7e #x08))
(check-equal? (enc 'movq '(b64 (base rax)) 'xmm1) (bytes #x66 #x0f #xd6 #x08))
(check-equal? (enc 'movd 'xmm1 'eax) (bytes #x66 #x0f #x6e #xc8))
(check-equal? (enc 'movd 'eax 'xmm1) (bytes #x66 #x0f #x7e #xc8))
(check-equal? (enc 'movd 'xmm1 '(b32 (base rax))) (bytes #x66 #x0f #x6e #x08))
(check-equal? (enc 'movd '(b32 (base rax)) 'xmm1) (bytes #x66 #x0f #x7e #x08))
(check-equal? (enc 'movdqa 'xmm1 'xmm2) (bytes #x66 #x0f #x6f #xca))
(check-equal? (enc 'movdqa 'xmm1 '(b128 (base rax))) (bytes #x66 #x0f #x6f #x08))
(check-equal? (enc 'movdqa '(b128 (base rax)) 'xmm1) (bytes #x66 #x0f #x7f #x08))
(check-equal? (enc 'addss 'xmm1 'xmm2) (bytes #xf3 #x0f #x58 #xca))
(check-equal? (enc 'subss 'xmm1 'xmm2) (bytes #xf3 #x0f #x5c #xca))
(check-equal? (enc 'mulss 'xmm1 'xmm2) (bytes #xf3 #x0f #x59 #xca))
(check-equal? (enc 'divss 'xmm1 'xmm2) (bytes #xf3 #x0f #x5e #xca))
(check-equal? (enc 'minss 'xmm1 'xmm2) (bytes #xf3 #x0f #x5d #xca))
(check-equal? (enc 'maxss 'xmm1 'xmm2) (bytes #xf3 #x0f #x5f #xca))
(check-equal? (enc 'sqrtss 'xmm1 'xmm1) (bytes #xf3 #x0f #x51 #xc9))
(check-equal? (enc 'ucomiss 'xmm1 'xmm2) (bytes #x0f #x2e #xca))
(check-equal? (enc 'roundss 'xmm1 'xmm1 1) (bytes #x66 #x0f #x3a #x0a #xc9 #x01))
(check-equal? (enc 'cvtss2sd 'xmm0 'xmm1) (bytes #xf3 #x0f #x5a #xc1))
(check-equal? (enc 'cvtsd2ss 'xmm0 'xmm0) (bytes #xf2 #x0f #x5a #xc0))
(check-equal? (enc 'cvtsi2ss 'xmm1 'rax) (bytes #xf3 #x48 #x0f #x2a #xc8))
(check-equal? (enc 'cvtsi2ss 'xmm1 'eax) (bytes #xf3 #x0f #x2a #xc8))
(check-equal? (enc 'ldmxcsr '(b32 (base rax))) (bytes #x0f #xae #x10))
(check-equal? (enc 'stmxcsr '(b32 (base rax))) (bytes #x0f #xae #x18))
(check-equal? (enc 'xorps 'xmm0 'xmm0) (bytes #x0f #x57 #xc0))
(check-equal? (enc 'xorpd 'xmm0 'xmm0) (bytes #x66 #x0f #x57 #xc0))
(check-equal? (enc 'orps 'xmm1 'xmm0) (bytes #x0f #x56 #xc8))

;; control/debug registers and PC system instructions
(check-equal? (enc 'mov 'cr0 'eax) (bytes #x0f #x22 #xc0))
(check-equal? (enc 'mov 'cr3 'rax) (bytes #x0f #x22 #xd8))
(check-equal? (enc 'mov 'rax 'cr2) (bytes #x0f #x20 #xd0))
(check-equal? (enc 'mov 'dr0 'rax) (bytes #x0f #x23 #xc0))
(check-equal? (enc 'mov 'rax 'dr0) (bytes #x0f #x21 #xc0))
(check-equal? (enc 'lgdt '(b64 (base rax))) (bytes #x0f #x01 #x10))
(check-equal? (enc 'lidt '(b64 (base rax))) (bytes #x0f #x01 #x18))
(check-equal? (enc 'lldt 'ax) (bytes #x0f #x00 #xd0))
(check-equal? (enc 'ltr 'ax) (bytes #x0f #x00 #xd8))
(check-equal? (enc 'rdmsr) (bytes #x0f #x32))
(check-equal? (enc 'wrmsr) (bytes #x0f #x30))
(check-equal? (enc 'swapgs) (bytes #x0f #x01 #xf8))
(check-equal? (enc 'sysretq) (bytes #x48 #x0f #x07))
(check-equal? (enc 'iretq) (bytes #x48 #xcf))
