+(define (elf-start-label? x)
+  (and (pair? x) (eq? (car x) '%label)
+       (let ((l (cadr x)))
+         (and (vector? l) (= 2 (vector-length l))
+              (eq? (vector-ref l 0) 'elf)
+              (eq? (vector-ref l 1) 'start)))))
+
+(define (elf-notice? x)
+  (and (pair? x) (eq? (car x) '%utf8z)
+       (string? (cadr x))
+       (string=? (cadr x) "Built with Loko Scheme <https://scheme.fail/>")))
+
+(define (mark-elf-header xs)
+  ;; 汇编期的 ELF 头(从 #(elf start) 到程序内容的第一条)换成一个标记.
+  (cond ((null? xs) '())
+        ((elf-start-label? (car xs))
+         (let skip ((ys (cdr xs)))
+           (cond ((null? ys) '((%elf-header)))
+                 ((elf-notice? (car ys)) (cons '(%elf-header) ys))
+                 (else (skip (cdr ys))))))
+        (else (cons (car xs) (mark-elf-header (cdr xs))))))
+
+(define (mark-elf-tail xs)
+  ;; 第一个 %call 或 %section elf 之后全是汇编期的 ELF 尾
+  ;; (segments/symtab/strtab/shstrtab)和一个闭包钩子: 换成一个标记.
+  (cond ((null? xs) '())
+        ((and (pair? (car xs)) (memq (caar xs) '(%call %section))
+              (or (eq? (caar xs) '%call)
+                  (eq? (cadar xs) 'elf)))
+         '((%elf-tail)))
+        (else (cons (car xs) (mark-elf-tail (cdr xs))))))
+
+(define (mark-elf-regions xs)
+  ;; %call 是汇编期闭包, 不可序列化, 其用途全部是 ELF writer:
+  ;; 头回卷 / strtab / symtab. 这里只标出区域, 丢不丢由编译器决定.
+  (mark-elf-tail (mark-elf-header xs)))
+
+(define (portable-tree x memo)
+  ;; Vectors are Loko labels, and labels are compared by object identity.
+  ;; Text serialization would make distinct labels with equal contents look
+  ;; the same, so give every vector object a stable unique symbol.
+  (cond
+    [(vector? x)
+     (or (hashtable-ref memo x #f)
+         (let ((s (string->symbol
+                   (string-append "loko-obj-vector-"
+                                  (number->string (hashtable-size memo))))))
+           (hashtable-set! memo x s)
+           s))]
+    [(pair? x)
+     (cons (portable-tree (car x) memo)
+           (portable-tree (cdr x) memo))]
+    [else x]))
+
+(define (dump-items path items)
+  (call-with-port
+   (open-file-output-port path (file-options no-fail) 'block
+                          (make-transcoder (utf-8-codec)))
+   (lambda (p)
+     (for-each (lambda (x) (write x p) (newline p)) items))))
+
+(define (dump-loko-program path asm)
+  (call-with-port
+   (open-file-output-port path (file-options no-fail) 'block
+                          (make-transcoder (utf-8-codec)))
+   (lambda (p)
+     (define memo (make-eq-hashtable))
+     (for-each (lambda (x) (write (portable-tree x memo) p) (newline p))
+               (mark-elf-regions asm)))))
+
