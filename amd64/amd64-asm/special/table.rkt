#lang racket
;;; amd64/amd64-asm/special/table.rkt
;;;
;;; Registry of handwritten special form families.

(require "../operand.rkt"
         "../encoding-plan.rkt"
         "common.rkt"
         "mov.rkt"
         "integer.rkt"
         "control.rkt"
         "string.rkt"
         "sse.rkt"
         "system.rkt")

(provide special-known?
         special-arity
         special-plan)

(struct special-def (arity plan) #:transparent)

(define special-table
  (hash
   'mov        (special-def 2 plan-mov)
   'add        (special-def 2 (lambda (ops) (plan-alu 'add ops)))
   'sub        (special-def 2 (lambda (ops) (plan-alu 'sub ops)))
   'and        (special-def 2 (lambda (ops) (plan-alu 'and ops)))
   'or         (special-def 2 (lambda (ops) (plan-alu 'or ops)))
   'xor        (special-def 2 (lambda (ops) (plan-alu 'xor ops)))
   'cmp        (special-def 2 (lambda (ops) (plan-alu 'cmp ops)))
   'lea        (special-def 2 plan-lea)
   'push       (special-def 1 plan-push)
   'pop        (special-def 1 plan-pop)
   'jmp-short  (special-def 1 plan-jmp-short)
   'jmp-near   (special-def 1 plan-jmp-near)
   'jmp-far    (special-def 2 plan-jmp-far)
   'jcc-short  (special-def 2 plan-jcc-short)
   'jcc-near   (special-def 2 plan-jcc-near)
   'call-near  (special-def 1 plan-call-near)
   'call-indirect (special-def 1 (lambda (ops) (plan-indirect-transfer 'call-indirect 2 ops)))
   'jmp-indirect  (special-def 1 (lambda (ops) (plan-indirect-transfer 'jmp-indirect 4 ops)))
   'test       (special-def 2 plan-test)
   'inc        (special-def 1 (lambda (ops) (plan-unary 'inc ops)))
   'dec        (special-def 1 (lambda (ops) (plan-unary 'dec ops)))
   'not        (special-def 1 (lambda (ops) (plan-unary 'not ops)))
   'neg        (special-def 1 (lambda (ops) (plan-unary 'neg ops)))
   'shl        (special-def 2 (lambda (ops) (plan-shift 'shl ops)))
   'shr        (special-def 2 (lambda (ops) (plan-shift 'shr ops)))
   'sar        (special-def 2 (lambda (ops) (plan-shift 'sar ops)))
   'rol        (special-def 2 (lambda (ops) (plan-shift 'rol ops)))
   'ror        (special-def 2 (lambda (ops) (plan-shift 'ror ops)))
   'rcl        (special-def 2 (lambda (ops) (plan-shift 'rcl ops)))
   'rcr        (special-def 2 (lambda (ops) (plan-shift 'rcr ops)))
   'imul       (special-def #f plan-imul)
   'div        (special-def 1 (lambda (ops) (plan-divide 'div ops)))
   'idiv       (special-def 1 (lambda (ops) (plan-divide 'idiv ops)))
   'movzx      (special-def 2 (lambda (ops) (plan-mov-extend #f ops)))
   'movsx      (special-def 2 (lambda (ops) (plan-mov-extend #t ops)))
   'setcc      (special-def 2 plan-setcc)
   'cmovcc     (special-def 3 plan-cmovcc)
   'xchg       (special-def 2 plan-xchg)
   'bswap      (special-def 1 plan-bswap)
   'bsf        (special-def 2 (lambda (ops) (plan-bit-scan 'bsf ops)))
   'bsr        (special-def 2 (lambda (ops) (plan-bit-scan 'bsr ops)))
   'popcnt     (special-def 2 (lambda (ops) (plan-bit-scan 'popcnt ops)))
   'shrd       (special-def 3 plan-shrd)
   'cmpxchg    (special-def 2 (lambda (ops)
                             (plan-binary-atomic 'cmpxchg
                                                   '(#x0f #xb0) '(#x0f #xb1) ops)))
   'xadd       (special-def 2 (lambda (ops)
                             (plan-binary-atomic 'xadd
                                                   '(#x0f #xc0) '(#x0f #xc1) ops)))
   'rdrand     (special-def 1 (lambda (ops) (plan-random-seed 'rdrand 6 ops)))
   'rdseed     (special-def 1 (lambda (ops) (plan-random-seed 'rdseed 7 ops)))
   'clflush    (special-def 1 plan-clflush)
   'in         (special-def 2 plan-in)
   'out        (special-def 2 plan-out)
   'movss      (special-def 2 plan-movss)
   'movd       (special-def 2 plan-movd)
   'movq       (special-def 2 plan-movq)
   'movdqa     (special-def 2 plan-movdqa)
   'addss      (special-def 2 (lambda (ops) (plan-sse-scalar 'addss #x58 (list #xf3) 32 ops)))
   'subss      (special-def 2 (lambda (ops) (plan-sse-scalar 'subss #x5c (list #xf3) 32 ops)))
   'mulss      (special-def 2 (lambda (ops) (plan-sse-scalar 'mulss #x59 (list #xf3) 32 ops)))
   'divss      (special-def 2 (lambda (ops) (plan-sse-scalar 'divss #x5e (list #xf3) 32 ops)))
   'minss      (special-def 2 (lambda (ops) (plan-sse-scalar 'minss #x5d (list #xf3) 32 ops)))
   'maxss      (special-def 2 (lambda (ops) (plan-sse-scalar 'maxss #x5f (list #xf3) 32 ops)))
   'sqrtss     (special-def 2 (lambda (ops) (plan-sse-scalar 'sqrtss #x51 (list #xf3) 32 ops)))
   'ucomiss    (special-def 2 (lambda (ops) (plan-sse-scalar 'ucomiss #x2e '() 32 ops)))
   'cvtss2sd   (special-def 2 (lambda (ops) (plan-sse-scalar 'cvtss2sd #x5a (list #xf3) 32 ops)))
   'cvtsd2ss   (special-def 2 (lambda (ops) (plan-sse-scalar 'cvtsd2ss #x5a (list #xf2) 64 ops)))
   'roundss    (special-def 3 plan-roundss)
   'cvtsi2ss   (special-def 2 plan-cvtsi2ss)
   'ldmxcsr    (special-def 1 (lambda (ops) (plan-mxcsr 'ldmxcsr 2 ops)))
   'stmxcsr    (special-def 1 (lambda (ops) (plan-mxcsr 'stmxcsr 3 ops)))
   'xorps      (special-def 2 (lambda (ops) (plan-sse-scalar 'xorps #x57 '() 128 ops)))
   'xorpd      (special-def 2 (lambda (ops) (plan-sse-scalar 'xorpd #x57 (list #x66) 128 ops)))
   'orps       (special-def 2 (lambda (ops) (plan-sse-scalar 'orps #x56 '() 128 ops)))
   'lgdt       (special-def 1 (lambda (ops) (plan-descriptor-table 'lgdt #x01 2 ops)))
   'lidt       (special-def 1 (lambda (ops) (plan-descriptor-table 'lidt #x01 3 ops)))
   'lldt       (special-def 1 (lambda (ops) (plan-system-rm16 'lldt 2 ops)))
   'ltr        (special-def 1 (lambda (ops) (plan-system-rm16 'ltr 3 ops)))
   'rdmsr      (special-def 0 (make-fixed-plan 'rdmsr '(#x0f #x32)))
   'wrmsr      (special-def 0 (make-fixed-plan 'wrmsr '(#x0f #x30)))
   'swapgs     (special-def 0 (make-fixed-plan 'swapgs '(#x0f #x01 #xf8)))
   'sysretq    (special-def 0 (make-fixed-plan 'sysretq '(#x48 #x0f #x07)))
   'iretq      (special-def 0 (make-fixed-plan 'iretq '(#x48 #xcf)))
   'movs       (special-def 2 plan-movs)
   'stos       (special-def 2 plan-stos)
   'ins        (special-def 2 plan-ins)
   'outs       (special-def 2 plan-outs)
   'cdqe       (special-def 0 (make-fixed-plan 'cdqe '(#x48 #x98)))
   'cpuid      (special-def 0 (make-fixed-plan 'cpuid '(#x0f #xa2)))
   'rdtsc      (special-def 0 (make-fixed-plan 'rdtsc '(#x0f #x31)))
   'rdtscp     (special-def 0 (make-fixed-plan 'rdtscp '(#x0f #x01 #xf9)))
   'syscall    (special-def 0 (make-fixed-plan 'syscall '(#x0f #x05)))
   'clc        (special-def 0 (make-fixed-plan 'clc '(#xf8)))
   'stc        (special-def 0 (make-fixed-plan 'stc '(#xf9)))
   'cld        (special-def 0 (make-fixed-plan 'cld '(#xfc)))
   'cli        (special-def 0 (make-fixed-plan 'cli '(#xfa)))
   'sti        (special-def 0 (make-fixed-plan 'sti '(#xfb)))
   'hlt        (special-def 0 (make-fixed-plan 'hlt '(#xf4)))
   'pause      (special-def 0 (make-fixed-plan 'pause '(#xf3 #x90)))
   'pushfq     (special-def 0 (make-fixed-plan 'pushfq '(#x9c)))
   'popfq      (special-def 0 (make-fixed-plan 'popfq '(#x9d)))
   'mfence     (special-def 0 (make-fixed-plan 'mfence '(#x0f #xae #xf0)))
   'lfence     (special-def 0 (make-fixed-plan 'lfence '(#x0f #xae #xe8)))
   'sfence     (special-def 0 (make-fixed-plan 'sfence '(#x0f #xae #xf8)))
   'cqo        (special-def 0 plan-cqo)
   'cdq        (special-def 0 plan-cdq)
   'ret        (special-def 0 plan-ret)
   'nop        (special-def 0 plan-nop)
   'ud2        (special-def 0 plan-ud2)))

(define (special-known? name)
  (and (hash-has-key? special-table name) #t))

(define (special-arity name)
  (define d (hash-ref special-table name #f))
  (and d (special-def-arity d)))

(define (special-plan name operands)
  (define d (hash-ref special-table name #f))
  (unless d
    (error 'special-plan "unknown special amd64 instruction: ~e" name))
  (define arity (special-def-arity d))
  (when (and arity (not (= (length operands) arity)))
    (error 'special-plan "~a expects ~a operand(s), got ~a: ~e"
           name arity (length operands) operands))
  (define result ((special-def-plan d) operands))
  (unless (encoding-plan? result)
    (error 'special-plan
           "special plan for ~a did not return an encoding plan: ~e"
           name result))
  result)
