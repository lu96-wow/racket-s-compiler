#lang racket/base

(require racket/list
         racket/string
         racket/format
         "../model.rkt")

(define (render-operand op)
  (list (operand-def-text op)
        (operand-def-kind op)
        (operand-def-width op)
        (operand-def-fixed op)))

(define (render-encoding enc)
  (list (list 'prefixes (encoding-def-prefixes enc))
        (list 'opcode (encoding-def-opcode enc))
        (list 'plus-r (encoding-def-plus-r enc))
        (list 'modrm-rm (encoding-def-modrm-rm enc))
        (list 'modrm-reg (encoding-def-modrm-reg enc))
        (list 'imm (encoding-def-imm enc))
        (list 'size-mode (encoding-def-size-mode enc))
        (list 'nw? (encoding-def-nw? enc))
        (list 'force-rex-w? (encoding-def-force-rex-w? enc))
        (list 'rex-b? (encoding-def-rex-b? enc))
        (list 'rex-x? (encoding-def-rex-x? enc))
        (list 'rex-r? (encoding-def-rex-r? enc))
        (list 'wait? (encoding-def-wait? enc))))

(define (render-form f)
  (list (form-mnemonic f)
        (map render-operand (form-operands f))
        (render-encoding (form-encoding f))
        (form-flags f)
        (form-line-number f)))

(define (table-content forms source-label commit)
  (string-append
   "#lang racket/base\n"
   ";; Generated by amd64/amd64-asm/binary-build/main.rkt. DO NOT EDIT.\n"
   ";;\n"
   ";; Authoritative source: NASM x86/insns.dat\n"
   (format ";; Preprocessed source: ~a\n" source-label)
   (format ";; Upstream commit:     ~a\n" commit)
   ";;\n"
   ";; Each form is:\n"
   ";;   (mnemonic operands encoding flags source-line)\n"
   ";; Operand: (source-text kind width fixed-register)\n"
   ";; Encoding keys: prefixes opcode plus-r modrm-rm modrm-reg imm\n"
   ";;                size-mode nw? force-rex-w? rex-b? rex-x? rex-r? wait?\n\n"
   "(provide forms\n         source-label\n         source-commit)\n\n"
   (format "(define source-label ~s)\n" source-label)
   (format "(define source-commit ~s)\n\n" commit)
   "(define forms\n  (list\n"
   (string-join
    (for/list ([f (in-list forms)])
      (format "   '~s" (render-form f)))
    "\n")
   "))\n"))

(provide table-content)
